{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-playground",
  "main": "./deploy/worker.ts",
  "compatibility_date": "2026-05-07",
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/runtime-config.js"]
  }
}
